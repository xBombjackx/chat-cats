# copy to .env
TWITCH_CHANNEL=yourchannel
KICK_CHANNEL=yourchannel
# only needed if the kick chatroom lookup fails (cloudflare); find it in kick.com/api/v2/channels/<slug> -> chatroom.id
#KICK_CHATROOM_ID=
PORT=8080
COOLDOWN_MS=2500
MAX_CATS=30
RESPAWN_HOURS=6

# Twitch EventSub (subs, bits, raids, follows, channel points). Register an app at dev.twitch.tv/console
# with OAuth redirect URL http://localhost:8080/auth/callback, then hit /admin -> Connect Twitch.
#TWITCH_CLIENT_ID=
#TWITCH_CLIENT_SECRET=

# set when exposing the server to the internet (companion page): gates /admin, /api, /auth and the overlay socket
#ADMIN_KEY=
